# TOML format -------------------------------------------------------------
# Contains Finite Source Parameters meta data 
# -------------------------------------------------------------------------
[model]
 citation  = '[Kaiser et al., 2012]'
 reference = 'Kaiser, A., Holden, C., Beavan, J., Beetham, D., Benites, R., Celentano, A., Collett, D., Cousins, J., Cubrinovski, M., Dellow, G. and Denys, P., 2012. The Mw 6.2 Christchurch earthquake of February 2011: preliminary report. New Zealand journal of geology and geophysics, 55(1), pp.67-90.'
 
[event]
 region    = 'Christchurch, New Zealand'
 public_ids = '3468575'
 evdate    = [22, 2, 2011]  # [dd, mm, yyyy]

[source]   # most can be retrived from the model file.
 Mw        = 6.2
 Mo        = nan
 evlat     = -43.570
 evlon     = 172.680
 evdep     = 5.0
 rlength   = nan
 rwidth    = nan
 strike    = nan
 dip       = nan
 rake      = nan
 hypX      = nan
 hypZ      = nan
 htop      = nan 
 avTr      = nan
 avVr      = nan
 
[inversion]
 Nseg      = nan
 Nx        = nan
 Nz        = nan
 Dx        = nan
 Dz        = nan
 Ntw       = nan
 SHF       = nan
 Fmin      = nan
 Fmax      = nan
 SVF       = 'Unknown'
 LEN       = nan

[inversion.data]
 type      = ['SGM', 'TELE', 'GPS', 'INSAR', 'OTHER']
 count     = [0,    0,     -999,     -999,     0]
 PHImx     = [0,    0,     -999,     -999,     0]
 Rmin      = [0,    0,     -999,     -999,     0] 

[inversion.cruststruct]
 nlayers   =  nan 
 model     = 'See the reference'
 
 
 
